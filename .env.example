# Copiá este archivo como .env y completá los valores.
# En Vercel, cargalos en Project Settings > Environment Variables.

# Turso: `turso db show <base> --url` y `turso db tokens create <base>`
# Si se deja vacío en local, se usa el archivo local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (se crea solo al conectar un Blob Store al proyecto).
# Si se deja vacío en local, `npm run dev` guarda los archivos en la carpeta .subidas-locales/
BLOB_READ_WRITE_TOKEN=

# Clave que los docentes les dan a los estudiantes para el buzón confidencial
CLAVE_ESTUDIANTES=cambiar-esta-clave

# Texto largo al azar para firmar la sesión: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Texto largo al azar. Vercel lo manda al llamar al cron diario de Instagram (/api/cron/instagram).
# Se genera igual que SESSION_SECRET.
CRON_SECRET=

# Opcional: token de larga duración de Instagram para la primera vez.
# Lo más simple es pegarlo en el panel (pestaña Instagram); después se renueva solo y se guarda en la base.
INSTAGRAM_TOKEN=

# Las cuentas del panel ya no usan una contraseña compartida (ADMIN_PASSWORD).
# Cada profe tiene la suya. La primera cuenta de administrador se crea con: npm run crear-admin
